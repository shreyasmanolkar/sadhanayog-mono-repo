# Copy names into ignored local files. Never put values in Git.
# Local Worker secrets live in apps/api/.dev.vars (see apps/api/.dev.vars.example).

# Public, safe to commit as names only
SADHANAYOG_ENV=development
SADHANAYOG_API_ORIGIN=http://127.0.0.1:8787
SADHANAYOG_WEB_ORIGIN=http://127.0.0.1:5173

# OIDC (values only in secrets / .dev.vars)
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=

# Cloudflare (local placeholders only; production IDs live in Wrangler cloud config)
# CLOUDFLARE_ACCOUNT_ID=
# D1_DATABASE_ID=
# R2_BUCKET_NAME=
