# Copy names into ignored local files. Never put secret values in Git.
# Local Worker secrets live in apps/api/.dev.vars (see apps/api/.dev.vars.example).

# Public local defaults (not secrets)
SADHANAYOG_ENV=development
SADHANAYOG_API_ORIGIN=http://127.0.0.1:8787
SADHANAYOG_WEB_ORIGIN=http://127.0.0.1:5173

# OIDC — names only. Values belong in ignored .dev.vars / a password manager.
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUDIENCE=

# Cloudflare — local placeholders. Production IDs are not created in Stage 1.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# D1_DATABASE_ID=
# R2_BUCKET_NAME=

# Optional Context7 MCP (higher rate limits). Name only; never commit the value.
# CONTEXT7_API_KEY=
