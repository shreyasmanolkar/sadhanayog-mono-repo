{
  "name": "@sadhanayog/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.jsonc --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist --config wrangler.jsonc",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute sadhanayog-dev --local --file ../../packages/db/migrations/0000_schema_migrations.sql"
  },
  "dependencies": {
    "@sadhanayog/contracts": "workspace:*",
    "@sadhanayog/db": "workspace:*",
    "hono": "4.9.8",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260818.1",
    "typescript": "5.9.2",
    "vitest": "3.2.4",
    "wrangler": "4.124.0"
  }
}
